MONGO_URI=mongodb://127.0.0.1:27017/disaster-warning
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# SMS through Brevo transactional SMS. Sender must be configured/approved in Brevo.
SMS_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SMS_SENDER=

# Optional Sri Lankan SMS provider for integration demos or paid service.
# Text.lk trial accounts advertise 10 free test SMS and the demo sender TextLKDemo.
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=

# Optional authentication for Expo Push API.
EXPO_ACCESS_TOKEN=

# Dispatch review policy. Defaults: 10/25/50/100 for Advisory/Watch/Warning/Evacuation Order.
ALERT_MIN_RECIPIENTS_ADVISORY=10
ALERT_MIN_RECIPIENTS_WATCH=25
ALERT_MIN_RECIPIENTS_WARNING=50
ALERT_MIN_RECIPIENTS_EVACUATION_ORDER=100
ALERT_CONFLICT_WINDOW_MINUTES=60
